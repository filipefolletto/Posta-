# Copie este arquivo para `.env` e preencha a chave para ativar a IA real.
# Sem AI_API_KEY, o Postaí continua funcionando com o gerador local.
AI_API_KEY=
# Base URL de um provedor compatível com OpenAI Chat Completions.
AI_BASE_URL=https://api.openai.com/v1
AI_TEXT_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
# Tempo máximo de uma chamada ao provedor, em milissegundos.
AI_TIMEOUT_MS=60000

# Porta do servidor de produção (`npm start`).
PORT=4173
